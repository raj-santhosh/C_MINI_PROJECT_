//---------------------------Add new record-----------------------------
void addNew(ST **ptr)
{
        ST *new,*p;
        new = malloc(sizeof(ST));
        int roll=1;

        while(1)
        {
                p = *ptr;
                while( p !=0)
                {
                        if(p->rollno == roll)
                                break;

                        p=p->next;
                }
                if(p == 0)
                        break;       // roll number not used
                roll++;
        }
        new->rollno=roll;

        printf("Enter name and marks \n");
        scanf("%s %f",new->name,&new->percentage);

        new->next = *ptr;
        *ptr = new;

}
