//--------------------------Save in file----------------------------------------
void saveFile(ST *ptr)
{
        if(ptr==0)
        {
                printf("No records found\n");
                return;
        }
        FILE *fp=fopen("student.dat","w");
        while(ptr)
        {
                fprintf(fp,"%d %s %f\n",ptr->rollno,ptr->name,ptr->percentage);
                ptr=ptr->next;
        }
        printf("--------Data saved in file.----------\n");
        fclose(fp);
}
