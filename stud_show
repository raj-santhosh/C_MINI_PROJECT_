//---------------------------Print node----------------------------------

void printNode(ST *ptr)
{
        printf("\033[37m---------------------------------------\n");
        if(ptr==0)
        {
                printf("No records present\n");
                printf("----------------------------------------\033[0m\n");
                return;
        }
        printf("Roll.No  Name   Percentage\n");
        printf("---------------------------------------\n");
        while(ptr)
        {
                printf("%d       %s      %f\n",ptr->rollno,ptr->name,ptr->percentage);
                ptr=ptr->next;
        }
        printf("---------------------------------------\033[0m\n\n");
}
