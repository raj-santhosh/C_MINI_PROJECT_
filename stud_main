//----------------------------------------------Main function-------------------------------------------------------------------
#include "header.h"
int main()
{
        ST *headptr=0;
        int c; char op,ch;
        readFile(&headptr);
        while(1)
      {
                printf("\033[35;3m**************STUDENT RECORD MENU***************\n");
                printf("|       a/A:Add new record                      |\n");
                printf("|       d/D:Delete a record                     |\n");
                printf("|       s/S:Show the list                       |\n");
                printf("|       m/M:Modify a record                     |\n");
                printf("|       v/V:Save records                        |\n");
                printf("|       t/T:Sort the list                       |\n");
                printf("|       l/L:Delete all the records              |\n");
                printf("|       r/R:Reverse the list                    |\n");
                printf("|       e/E:Exit                                |\n");
                printf("|_______________________________________________|\n\033[0m");
                printf("Enter your choice :\n");
                scanf(" %c",&op);
                switch(op)
                {
                        case 'a':
                        case 'A':
                                addNew(&headptr);
                                break;
                        case 'd':
                        case 'D':
                                deleteNode(&headptr);
                                break;
                        case 's':
                        case 'S':
                                printNode(headptr);
                                break;
                        case 't':
                        case 'T':
                                sortList(headptr);
                                break;
                        case 'v':
                        case 'V':
                                saveFile(headptr);
                                break;
                        case 'r':
                        case 'R':
                                reverseList(&headptr);
                                break;
                        case 'm':
                        case 'M':
                                modifyRec(headptr);
                                break;
                        case 'l':
                        case 'L':
                                deleteAll(&headptr);
                                break;
                        case 'e':
                        case 'E':
                                printf("S/s:Save and exit\nE/e:Exit without saving\n");
                                scanf(" %c",&ch);
                                switch(ch)
                                {
                                        case 's':
                                        case 'S':
                                                saveFile(headptr);
                                                exit(0); break;
                                        case 'e':
                                        case 'E':
                                                exit(0);break;
                                }
                                break;
                        default:
                                printf("\033[31;3m Unknown choice \033[0m\n");
                                break;
                }

        }
}
