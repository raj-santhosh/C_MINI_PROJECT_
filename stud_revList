//-----------------------------reverseList---------------------------------
void reverseList(ST **ptr)
{
        if(*ptr==0)
        {
                printf("No records present..\n");
                return;
        }
        int i,c=countNode(*ptr);
        ST **a,*t=*ptr;
        if(c>1)
        {

                a=malloc(sizeof(ST*)*c);
                for(i=0;i<c;i++) // stroring address
                {
                        a[i]=t;
                        t=t->next;
                }
                for(i=c-1;i>0;i--)
                        a[i]->next=a[i-1];

                a[0]->next=0;
                *ptr=a[c-1];
        }
        printf("Reverselist success..\n");
        free(a);
}
