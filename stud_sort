//-----------------------------sortList----------------------------------

void sortList(ST *ptr)
{
        if(ptr==0){
                printf("No records present.\n");
                return; }

        ST *p1=ptr,*p2,t;
        int i,j,c=countNode(ptr);
        char ch;
        printf("N/n:Sort with name\nP/p:Sort with percentage\n");
        scanf(" %c",&ch);
        switch(ch)
        {
                case 'p':
                case 'P':
                        for(i=0;i<c-1;i++)
                        {
                                p2=p1->next;
                                for(j=0;j<c-1-i;j++)
                                {
                                        if(p1->percentage < p2->percentage)
                                        {
                                                t.percentage = p1->percentage;
                                                strcpy(t.name,p1->name);

                                                p1->percentage = p2->percentage;
                                                strcpy(p1->name,p2->name);

                                                p2->percentage = t.percentage;
                                                strcpy(p2->name,t.name);

                                        }
                                        p2=p2->next;
                                }
                                p1=p1->next;

                        }
                        printf("Sorted according to percentage\n");
                        break;
                case 'N':
                case 'n':
                        for(i=0;i<c-1;i++)
                        {
                                p2=p1->next;
                                for(j=0;j<c-1-i;j++)
                                {
                                        if(strcmp(p1->name,p2->name)>0)
                                        {
                                                t.percentage = p1->percentage;
                                                strcpy(t.name,p1->name);

                                                p1->percentage = p2->percentage;
                                                strcpy(p1->name,p2->name);

                                                p2->percentage = t.percentage;
                                                strcpy(p2->name,t.name);

                                        }
                                        p2=p2->next;
                                }
                                p1=p1->next;
                        }
                        printf("Sorted according to name\n");
                        break;
        }
}
